# --- HashKey Chain ---
HSK_NETWORK=hashkey                     # hashkey (mainnet, 177) | hashkey-testnet (133)
HSK_RPC=https://mainnet.hsk.xyz
PRIVATE_KEY=                            # deployer (Hardhat)

# --- HSP merchant credentials (receiving agent) ---
HSP_APP_KEY=
HSP_APP_SECRET=
HSP_BASE_URL=                           # defaults per network: hsp.hashkey.com / merchant-qa.hashkeymerchant.com
MERCHANT_NAME=Credence Risk Agent
MERCHANT_JWT_PRIVATE_KEY=keys/merchant_private_key.pem   # secp256k1 PEM (ES256K)
MERCHANT_JWT_PUBLIC_KEY=keys/merchant_public_key.pem

# --- Agent wallets ---
MERCHANT_AGENT_KEY=                     # receives payments, SETTLER on the registry
BUYER_AGENT_KEY=                        # payment agent wallet (holds USDC)

# --- Credence contracts ---
A2A_REGISTRY_ADDRESS=
SPENDING_POLICY_ADDRESS=
SETTLEMENT_MODE=hsp                     # hsp | direct

# --- AI ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
