# --- HashKey Chain ---
HSK_NETWORK=hashkey-testnet             # hashkey-testnet (133, HSP QA) | hashkey (mainnet, 177)
PRIVATE_KEY=                            # deployer (Hardhat)

# --- HSP Agentic Payment (MCP). App Key/Secret are held by HSP; you only need IP allowlisting. ---
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
HSP_TEAM_NAME=Credence7                 # merchant_name: exact team reporting name, used on create and query
HSP_COIN=USDC                           # chosen from get_chain_config

# --- Agent wallets ---
MERCHANT_AGENT_KEY=                     # receiving agent: pay_to, SETTLER on the registry (needs gas)
BUYER_AGENT_KEY=                        # payment agent: signs EIP-712 authorisations (holds the test token)

# --- Credence contracts (same chain as HSK_NETWORK) ---
A2A_REGISTRY_ADDRESS=
SPENDING_POLICY_ADDRESS=

# --- A2A ---
MERCHANT_AGENT_URL=                     # remote receiving agent (A2A), e.g. http://localhost:8001; empty = in-process
PUBLIC_BASE_URL=                        # URL the receiving agent advertises in its Agent Card

# --- AI ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
